# 将本文件复制为 .env，并填写实际运行值。不要提交 .env。

# LLM 上游配置
MUYE_LLM_API_BASE_URL=https://your-openai-compatible-endpoint.example/v1
MUYE_LLM_API_KEY=
MUYE_LLM_DEFAULT_MODEL=your-model-alias
MUYE_LLM_DEFAULT_THINKING=false
MUYE_LLM_MODELS_JSON=[{"id":"your-model-alias","name":"Your Model","provider_model":"provider-model","supports_thinking":false}]

# Embedding 上游配置
MUYE_LLM_EMBED_API_BASE_URL=https://your-openai-compatible-endpoint.example/v1
MUYE_LLM_EMBED_API_KEY=
MUYE_LLM_EMBED_DEFAULT_MODEL=your-embedding-alias
MUYE_LLM_EMBED_MODELS_JSON=[{"id":"your-embedding-alias","name":"Your Embedding Model","provider_model":"provider-embedding-model","dimensions":1024}]

# Rerank 默认关闭；启用时填写 DashScope 完整接口、密钥和模型 alias
MUYE_LLM_RERANK_ENABLED=false
MUYE_LLM_RERANK_API_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
MUYE_LLM_RERANK_API_KEY=
MUYE_LLM_RERANK_DEFAULT_MODEL=your-rerank-alias
MUYE_LLM_RERANK_MODELS_JSON=[{"id":"your-rerank-alias","name":"Your Rerank Model","provider_model":"gte-rerank-v2","provider":"dashscope"}]

# 只读数据召回默认不启动；启用前按 muye-data/config.example.yaml 创建 config.yaml
MUYE_DATA_ENABLED=false
MUYE_DATA_CONFIG_PATH=config.yaml
MUYE_DATA_LLM_BASE_URL=http://127.0.0.1:9850
MUYE_DATA_URL=http://127.0.0.1:9840
# config.example.yaml 默认资源只引用 Milvus。
MUYE_DATA_MILVUS_TOKEN=
MUYE_DATA_RESOURCE_SNAPSHOT_PATH=
MUYE_SDK_DATA_BASE_URL=http://127.0.0.1:9840
MUYE_SDK_DATA_TIMEOUT_SECONDS=15
MUYE_SDK_DATA_MAX_RETRIES=0

# 主 Agent 与子 Agent 服务地址
MUYE_LLM_BASE_URL=http://127.0.0.1:9850
MUYE_LLM_MODEL=your-model-alias
MUYE_AGENT_TRAVEL_URL=http://127.0.0.1:8011
MUYE_AGENT_ORDER_URL=http://127.0.0.1:8012

# 本地默认使用 SQLite，且不启用外部记忆服务
CHECKPOINTER_BACKEND=sqlite
CHECKPOINTER_SQLITE_PATH=conversations.db
MEMORY_ENABLE_REDIS=false
MEMORY_ENABLE_MONGODB=false
MEMORY_ENABLE_EVERMEM=false

# 本地控制台
MUYE_DASHBOARD_HOST=127.0.0.1
MUYE_DASHBOARD_PORT=9870
