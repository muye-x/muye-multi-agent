# 根启动器是否启动本地 muye-data；Compose 不使用该开关。
# Whether the root launcher starts local muye-data; Compose does not use this switch.
MUYE_DATA_ENABLED=false

# muye-data 进程配置 / muye-data process configuration
MUYE_DATA_HOST=127.0.0.1
MUYE_DATA_PORT=9840
MUYE_DATA_WORKERS=1
MUYE_DATA_LOG_LEVEL=INFO
MUYE_DATA_CONFIG_PATH=config.yaml

# 内网 muye-llm；Embedding 和 Rerank 均通过该服务调用
# Internal muye-llm; both Embedding and Rerank are called through this service.
MUYE_DATA_LLM_BASE_URL=http://127.0.0.1:9850
MUYE_DATA_LLM_TIMEOUT=10

# 单阶段与完整请求预算。数据库瞬时错误最多重试一次。
# Per-stage and total request budgets. Transient database errors are retried at most once.
MUYE_DATA_BACKEND_TIMEOUT=5
MUYE_DATA_TOTAL_TIMEOUT=15
MUYE_DATA_BACKEND_MAX_RETRIES=1
MUYE_DATA_RERANK_MAX_DOCUMENTS=100

# config.yaml 只引用该变量名，不应把实际凭据写入 YAML。
# config.yaml references only this variable name; never write actual credentials in YAML.
MUYE_DATA_MILVUS_TOKEN=

# 阶段 4 发布的 ResourceSnapshotV1；未设置时继续使用 config.yaml 的静态 resources。
# ResourceSnapshotV1 published in Phase 4; when unset, static resources from config.yaml remain in use.
MUYE_DATA_RESOURCE_SNAPSHOT_PATH=
MUYE_DATA_RESOURCE_SNAPSHOT_POLL_SECONDS=5

# 阶段 5 SubAgent 服务身份；生产环境必须启用并挂载 Control active Catalog。
# Phase 5 SubAgent service identity; production must enable it and mount the active Control Catalog.
# 每个 agent_id 使用独立 Data token，且不能复用该 Agent 的 Main/Control token。
# Each agent_id uses a distinct Data token, which must not reuse that Agent's Main or Control token.
MUYE_DATA_AGENT_AUTH_ENABLED=false
MUYE_DATA_AGENT_CATALOG_PATH=../config/runtime/control/active-catalog.json
MUYE_DATA_AGENT_TOKENS_JSON={}
# local-dev 由 `agent dev` 临时设置该路径，并清空 MUYE_DATA_AGENT_CATALOG_PATH。
# `agent dev` sets this path temporarily for local development and clears MUYE_DATA_AGENT_CATALOG_PATH.
# MUYE_DATA_LOCAL_DEV_REGISTRATION_PATH=../config/runtime/dev/<slug>/registration.json
