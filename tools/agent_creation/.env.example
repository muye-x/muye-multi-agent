# 仅供 `./scripts/muye.sh agent prepare/create` 使用。复制为 .env 后填写实际值。
# 不要提交包含 token 的 .env。

# 已启动 muye-llm 的内部地址；模型和 Embedding alias 由 muye-llm/.env 管理。
MUYE_KNOWLEDGE_LLM_BASE_URL=http://127.0.0.1:9850

# 知识构建与 candidate 评测使用的 Milvus 连接。
MUYE_KNOWLEDGE_MILVUS_URI=http://127.0.0.1:19530
MUYE_KNOWLEDGE_MILVUS_TOKEN=
