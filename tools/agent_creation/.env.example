# 仅供 `./scripts/muye.sh agent prepare/create` 使用。复制为 .env 后填写实际值。
# Used only by `./scripts/muye.sh agent prepare/create`. Copy to .env and provide values.
# 不要提交包含 token 的 .env。
# Do not commit an .env file containing tokens.

# 已启动 muye-llm 的内部地址；模型和 Embedding alias 由 muye-llm/.env 管理。
# Internal address of the running muye-llm; model and Embedding aliases are managed in muye-llm/.env.
MUYE_KNOWLEDGE_LLM_BASE_URL=http://127.0.0.1:9850

# 知识构建与 candidate 评测使用的 Milvus 连接。
# Milvus connection used for knowledge construction and candidate evaluation.
MUYE_KNOWLEDGE_MILVUS_URI=http://127.0.0.1:19530
MUYE_KNOWLEDGE_MILVUS_TOKEN=
