# 仅供 `./scripts/muye.sh agent build/deploy/stop/rollback` 使用。
# 复制为 .env 后填写部署 API 凭据；不要提交真实 token。

# Control 部署 API 与 operator 凭据。
MUYE_CONTROL_BASE_URL=
MUYE_CONTROL_OPERATOR_TOKEN=

# 通过 Main 执行部署后 smoke 的内部地址与调用身份。
MUYE_MAIN_BASE_URL=
MUYE_MAIN_CALLER_TOKEN=
MUYE_AGENT_SMOKE_USER_ID=

# 可选 Compose 与构建参数。基础镜像必须使用固定 digest。
MUYE_COMPOSE_PROJECT_NAME=muye
MUYE_COMPOSE_BASE_FILES=compose.yaml
MUYE_AGENT_BASE_IMAGE=
