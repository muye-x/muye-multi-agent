# Control 服务与 PostgreSQL 配置。复制为 .env 后填写实际值；不要提交 .env。
MUYE_CONTROL_HOST=127.0.0.1
MUYE_CONTROL_PORT=9880
MUYE_CONTROL_DATABASE_URL=
MUYE_CONTROL_OPERATOR_TOKEN=
MUYE_CONTROL_MAIN_TOKEN=
MUYE_CONTROL_HEALTH_TOKEN=
MUYE_CONTROL_GATEWAY_TOKEN=
MUYE_CONTROL_AGENT_TOKENS_JSON={}
MUYE_CONTROL_STATE_ROOT=config/runtime/control
MUYE_CONTROL_ACCESS_TTL_SECONDS=900
MUYE_CONTROL_COOKIE_SECURE=true
MUYE_CONTROL_HEALTH_POLL_SECONDS=5
MUYE_CONTROL_HEALTH_FAILURE_THRESHOLD=3
MUYE_CONTROL_HEALTH_SUCCESS_THRESHOLD=2
MUYE_CONTROL_HEALTH_WINDOW_SECONDS=60

# Compose PostgreSQL 容器使用；应与 MUYE_CONTROL_DATABASE_URL 中的凭据保持一致。
POSTGRES_DB=muye
POSTGRES_USER=muye
POSTGRES_PASSWORD=
