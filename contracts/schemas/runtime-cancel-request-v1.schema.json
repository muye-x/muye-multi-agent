{
  "$id": "https://muye.ai/schemas/runtime-cancel-request-v1.schema.json",
  "additionalProperties": false,
  "description": "Core 对 Runtime 的协作式取消请求。",
  "properties": {
    "reason": {
      "enum": [
        "client_disconnect",
        "timeout",
        "deployment_drain",
        "operator"
      ],
      "title": "Reason",
      "type": "string"
    },
    "request_id": {
      "pattern": "^request_[a-f0-9]{16,64}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "muye.ai/runtime-cancel-request/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "reason"
  ],
  "title": "RuntimeCancelRequestV1",
  "type": "object"
}
