# 将本文件复制为 .env，并填写实际运行值。不要提交 .env。

# 服务监听配置
MUYE_AGENT_HOST=127.0.0.1
MUYE_AGENT_PORT=8011

# SDK 模型与 API profile
MUYE_SDK_MODEL_PROVIDER=muye
MUYE_SDK_MODEL_BASE_URL=http://127.0.0.1:9850
MUYE_SDK_MODEL=your-model-alias
MUYE_SDK_MODEL_ENABLE_THINKING=false
MUYE_SDK_DATA_BASE_URL=http://127.0.0.1:9840
MUYE_SDK_DATA_TIMEOUT_SECONDS=15
MUYE_SDK_DATA_MAX_RETRIES=0
MUYE_SDK_API_PROFILES=internal,public
MUYE_SDK_PUBLIC_PATH=/api/v1/travel
MUYE_SDK_REQUEST_TIMEOUT_SECONDS=60

# 默认不保存短期上下文，也不启用意图守卫
MUYE_SDK_CONTEXT_PROFILES=
MUYE_SDK_CONTEXT_BACKEND=memory
MUYE_SDK_INTENT_GUARD=false
