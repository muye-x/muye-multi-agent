# 将本文件复制为 .env，并填写实际运行值。不要提交 .env。

# 服务监听配置
MUYE_AGENT_HOST=127.0.0.1
MUYE_AGENT_PORT=9860
SERVER_WORKERS=1
SERVER_LOG_LEVEL=info
SERVER_ACCESS_LOG=true

# 内部模型网关与子 Agent
MUYE_LLM_BASE_URL=http://127.0.0.1:9850
MUYE_LLM_MODEL=your-model-alias
MUYE_SDK_DATA_BASE_URL=http://127.0.0.1:9840
MUYE_SDK_DATA_TIMEOUT_SECONDS=15
MUYE_SDK_DATA_MAX_RETRIES=0
MUYE_AGENT_TRAVEL_URL=http://127.0.0.1:8011
MUYE_AGENT_ORDER_URL=http://127.0.0.1:8012
MUYE_AGENT_SUB_AGENT_TIMEOUT=20

# 本地持久化配置
CHECKPOINTER_BACKEND=sqlite
CHECKPOINTER_SQLITE_PATH=conversations.db
# MEMORY_ENABLED=false 会完全关闭主 Agent 的记忆读取、注入和更新。
MEMORY_ENABLED=false
MEMORY_ENABLE_REDIS=false
MEMORY_ENABLE_MONGODB=false
MEMORY_ENABLE_EVERMEM=false

# 可选网页检索；使用对应服务时填写密钥
WEB_SEARCH_ENGINES=ddg
WEB_SEARCH_ENGINE_PRIORITY=ddg
LANGSEARCH_API_KEY=
TAVILY_API_KEY=
INFOQUEST_API_KEY=
SERPER_API_KEY=
JINA_API_KEY=
