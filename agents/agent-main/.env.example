# 将本文件复制为 .env，并填写实际运行值。不要提交 .env。
# Copy this file to .env and provide runtime values. Do not commit .env.

# 服务监听配置 / Service listener configuration
MUYE_AGENT_HOST=127.0.0.1
MUYE_AGENT_PORT=9860
SERVER_WORKERS=1
SERVER_LOG_LEVEL=info
SERVER_ACCESS_LOG=true

# 内部模型网关与阶段 5 Control/Catalog / Internal model gateway and Phase 5 Control/Catalog
MUYE_LLM_BASE_URL=http://127.0.0.1:9850
MUYE_LLM_MODEL=your-model-alias
MUYE_SDK_DATA_BASE_URL=http://127.0.0.1:9840
MUYE_SDK_DATA_TIMEOUT_SECONDS=15
MUYE_SDK_DATA_MAX_RETRIES=0
MUYE_CONTROL_BASE_URL=
MUYE_CONTROL_MAIN_TOKEN=
MUYE_MAIN_CALLER_TOKEN=
# 独立 channels 服务调用 /internal/v1/channels/invoke 的凭据，不可复用其他 token。
MUYE_CHANNELS_MAIN_TOKEN=
# 流式请求在工具执行期间的空闲和总持有上限；微信入口单次请求超时后会释放会话锁。
MUYE_STREAM_IDLE_TIMEOUT_SECONDS=240
MUYE_STREAM_MAX_HOLD_TIMEOUT_SECONDS=600
MUYE_CHANNELS_INVOKE_TIMEOUT_SECONDS=180
MUYE_MAIN_AGENT_TOKENS_JSON={}
MUYE_CATALOG_POLL_SECONDS=5
MUYE_CONTROL_TIMEOUT_SECONDS=5
MUYE_AGENT_CIRCUIT_FAILURE_THRESHOLD=3
MUYE_AGENT_CIRCUIT_RECOVERY_SECONDS=30
# 同一子 Agent 的并发名额等待时间及单个用户请求调用次数上限。
MUYE_AGENT_QUEUE_WAIT_SECONDS=10
MUYE_AGENT_MAX_CALLS_PER_REQUEST=1
# JSON 中每个 agent_id 使用独立 Main token；不能复用该 Agent 的 Control/Data token。
# Each agent_id in the JSON uses a distinct Main token; do not reuse its Control or Data token.
# local-dev 由 `agent dev` 临时注入下列变量，不要在生产 .env 中设置或提交注册文件。
# `agent dev` injects the following variables temporarily for local development; do not set them in production .env files or commit registration files.
# MUYE_CATALOG_MODE=local-dev
# MUYE_LOCAL_DEV_REGISTRATION_PATH=../../config/runtime/dev/<slug>/registration.json
# MUYE_LOCAL_DEV_USER_ID=local-dev-user

# 本地持久化配置 / Local persistence configuration
CHECKPOINTER_BACKEND=sqlite
CHECKPOINTER_SQLITE_PATH=conversations.db
# MEMORY_ENABLED=false 会完全关闭主 Agent 的记忆读取、注入和更新。
# MEMORY_ENABLED=false fully disables MainAgent memory reads, injection, and updates.
MEMORY_ENABLED=false
MEMORY_ENABLE_REDIS=false
MEMORY_ENABLE_MONGODB=false
MEMORY_ENABLE_EVERMEM=false

# 可选网页检索；使用对应服务时填写密钥
# Optional web search; provide the corresponding key only when using a service.
WEB_SEARCH_ENGINES=ddg
WEB_SEARCH_ENGINE_PRIORITY=ddg
LANGSEARCH_API_KEY=
TAVILY_API_KEY=
INFOQUEST_API_KEY=
SERPER_API_KEY=
JINA_API_KEY=
