MUYE_CHANNELS_ENCRYPTION_KEY=
MUYE_CHANNELS_SQLITE_PATH=state/channels.db
WECHAT_ILINK_BASE_URL=https://ilinkai.weixin.qq.com/ilink/bot
WECHAT_ILINK_ALLOWED_HOSTS=ilinkai.weixin.qq.com
