# Optional local WeChat channel. Do not commit the real .env file.
MUYE_CHANNELS_ENABLED=false
MUYE_CHANNELS_HOST=127.0.0.1
MUYE_CHANNELS_PORT=9890
MUYE_CHANNELS_CALLER_TOKEN=
MUYE_CHANNELS_MAIN_URL=http://127.0.0.1:9860
MUYE_CHANNELS_MAIN_TOKEN=
