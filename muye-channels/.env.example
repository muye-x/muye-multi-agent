# Optional local WeChat channel. Do not commit the real .env file.
MUYE_CHANNELS_ENABLED=false
MUYE_CHANNELS_HOST=127.0.0.1
MUYE_CHANNELS_PORT=9890
MUYE_CHANNELS_CALLER_TOKEN=
MUYE_CHANNELS_MAIN_URL=http://127.0.0.1:9860
MUYE_CHANNELS_MAIN_TOKEN=
# MainAgent 联网工具可能耗时较长；最大值为 300 秒。
MUYE_CHANNELS_AGENT_TIMEOUT_SECONDS=240
# Base64-encoded 32-byte AES-GCM key. Generate outside version control.
MUYE_CHANNELS_ENCRYPTION_KEY=
MUYE_CHANNELS_DATABASE_URL=
WECHAT_ILINK_BASE_URL=https://ilinkai.weixin.qq.com/ilink/bot
WECHAT_ILINK_ALLOWED_HOSTS=ilinkai.weixin.qq.com
