# PostgreSQL facts and content-addressed artifact storage.
MUYE_CORE_DATABASE_URL=postgresql://muye:change-me@127.0.0.1:5432/muye
MUYE_CORE_ARTIFACT_ROOT=/var/lib/muye/artifacts

# Phase 2 Knowledge Worker. Secrets belong in the runtime environment, not this file.
MUYE_CORE_LLM_BASE_URL=http://127.0.0.1:9850
MUYE_CORE_EMBEDDING_DIMENSIONS=1024
MUYE_CORE_EMBEDDING_REVISION=r1
MUYE_CORE_MILVUS_URI=http://127.0.0.1:19530
MUYE_CORE_MILVUS_TOKEN=
MUYE_CORE_MILVUS_CONNECTION=core_milvus
MUYE_CORE_EVALUATION_DATA_BASE_URL=http://127.0.0.1:9840
MUYE_CORE_EVALUATION_SNAPSHOT_PATH=/var/lib/muye/evaluation/resource-snapshot.json
MUYE_CORE_OCR_AVAILABLE=false
MUYE_CORE_WORKER_LEASE_SECONDS=60
MUYE_CORE_WORKER_POLL_SECONDS=1
