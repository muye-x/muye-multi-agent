# Agent 本地运行配置。复制为 .env 后填写；不要提交 .env 或真实 token。
# Local Agent runtime configuration. Copy to .env and provide values; do not commit .env or real tokens.
# agent.yaml 固定模型 alias、检索资源和预算，不能在本文件中覆盖。
# agent.yaml fixes the model alias, retrieval resources, and budgets; this file cannot override them.

# 已启动的内部服务地址 / Addresses of running internal services
MUYE_LLM_BASE_URL=http://127.0.0.1:9850
MUYE_SDK_DATA_BASE_URL=http://127.0.0.1:9840
MUYE_SDK_DATA_TIMEOUT_SECONDS=15
MUYE_SDK_DATA_MAX_RETRIES=0
MUYE_SDK_API_PROFILES=internal

# 本地或部署层注入的 Agent 身份。descriptor/source checksum 必须是 64 位十六进制值。
# Agent identity injected locally or by the deployment layer. Descriptor/source checksums must be 64-character hexadecimal values.
MUYE_AGENT_SERVICE_ID=
MUYE_AGENT_DEPLOYMENT_ID=
MUYE_AGENT_DESCRIPTOR_CHECKSUM=
MUYE_AGENT_SOURCE_TREE_CHECKSUM=

# 三个 token 必须非空且互不相同。Main token 用于 /invoke；Control token 只用于 /capabilities；
# The three tokens must be non-empty and distinct. The Main token is for /invoke; the Control token is only for /capabilities;
# Data token 只用于访问 muye-data。部署环境应由密钥管理系统注入这些值。
# the Data token is only for muye-data. Deployment environments should inject these values through a secret manager.
MUYE_AGENT_MAIN_TOKEN=
MUYE_AGENT_CONTROL_TOKEN=
MUYE_AGENT_DATA_TOKEN=
