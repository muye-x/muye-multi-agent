# 将本文件复制为 .env，并填写实际部署值。不要提交 .env。
# Copy this file to .env and provide deployment values. Do not commit .env.

# Nginx 对外服务配置。浏览器使用 Control 登录会话，不存在共享用户 API Key。
# Public Nginx configuration. Browsers use Control login sessions; there is no shared user API key.
MUYE_GATEWAY_SERVER_NAME=gateway.example.com
MUYE_GATEWAY_TLS_CERTIFICATE_PATH=/path/to/fullchain.pem
MUYE_GATEWAY_TLS_PRIVATE_KEY_PATH=/path/to/private-key.pem
MUYE_GATEWAY_CLIENT_MAX_BODY_SIZE=50m
MUYE_GATEWAY_PROXY_READ_TIMEOUT=3600s
MUYE_GATEWAY_PROXY_SEND_TIMEOUT=3600s

# Nginx 上游服务 / Nginx upstream services
MUYE_AGENT_MAIN_URL=http://127.0.0.1:9860
MUYE_DASHBOARD_API_URL=http://127.0.0.1:9870
MUYE_CONTROL_BASE_URL=http://127.0.0.1:9880
# 必须与 Control 的 MUYE_CONTROL_GATEWAY_TOKEN 相同，但不能复用任何其他服务 token。
# Must equal Control's MUYE_CONTROL_GATEWAY_TOKEN, but must not reuse any other service token.
MUYE_GATEWAY_CONTROL_TOKEN=
MUYE_MAIN_CALLER_TOKEN=

# 本地运维控制台 / Local operations console
MUYE_DASHBOARD_HOST=127.0.0.1
MUYE_DASHBOARD_PORT=9870
MUYE_DASHBOARD_LOG_LEVEL=info
MUYE_LLM_URL=http://127.0.0.1:9850
MUYE_DATA_ENABLED=false
MUYE_DATA_URL=http://127.0.0.1:9840

# 生产部署后的 smoke test 地址 / Smoke-test URL after production deployment
MUYE_GATEWAY_BASE_URL=https://gateway.example.com
