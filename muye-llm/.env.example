# 将本文件复制为 .env，并填写实际运行值。不要提交 .env。
# Copy this file to .env and provide runtime values. Do not commit .env.

# 服务监听配置 / Service listener configuration
MUYE_LLM_HOST=127.0.0.1
MUYE_LLM_PORT=9850
MUYE_LLM_WORKERS=1
MUYE_LLM_LOG_LEVEL=INFO

# Chat Completions 上游配置 / Chat Completions upstream configuration
MUYE_LLM_API_BASE_URL=https://your-openai-compatible-endpoint.example/v1
MUYE_LLM_API_KEY=
MUYE_LLM_DEFAULT_MODEL=your-model-alias
MUYE_LLM_DEFAULT_THINKING=false
MUYE_LLM_MODELS_JSON=[{"id":"your-model-alias","name":"Your Model","provider_model":"provider-model","supports_thinking":false}]
MUYE_LLM_EXTRA_BODY_JSON={}

# Embedding 上游配置 / Embedding upstream configuration
MUYE_LLM_EMBED_API_BASE_URL=https://your-openai-compatible-endpoint.example/v1
MUYE_LLM_EMBED_API_KEY=
MUYE_LLM_EMBED_DEFAULT_MODEL=your-embedding-alias
MUYE_LLM_EMBED_MODELS_JSON=[{"id":"your-embedding-alias","name":"Your Embedding Model","provider_model":"provider-embedding-model","dimensions":1024}]
# 兼容旧配置：未设置 MUYE_LLM_EMBED_MODELS_JSON 时，使用以下单个 provider 模型名作为 alias。
# Backward compatibility: when MUYE_LLM_EMBED_MODELS_JSON is unset, use the following provider model name as the alias.
# MUYE_LLM_EMBED_MODEL=provider-embedding-model

# Rerank 默认关闭。启用时必须填写 API Key，并配置对调用方稳定的模型 alias。
# Rerank is disabled by default. Enabling it requires an API key and a stable model alias for callers.
MUYE_LLM_RERANK_ENABLED=false
MUYE_LLM_RERANK_API_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
MUYE_LLM_RERANK_API_KEY=
MUYE_LLM_RERANK_DEFAULT_MODEL=your-rerank-alias
MUYE_LLM_RERANK_MODELS_JSON=[{"id":"your-rerank-alias","name":"Your Rerank Model","provider_model":"gte-rerank-v2","provider":"dashscope"}]
MUYE_LLM_RERANK_TIMEOUT=10
MUYE_LLM_RERANK_MAX_RETRIES=2
MUYE_LLM_RERANK_MAX_DOCUMENTS=100
MUYE_LLM_RERANK_MAX_QUERY_CHARS=8000
MUYE_LLM_RERANK_MAX_DOCUMENT_CHARS=16000
MUYE_LLM_RERANK_MAX_TOTAL_CHARS=200000

# 调用参数 / Request parameters
MUYE_LLM_DEFAULT_TEMPERATURE=0.1
MUYE_LLM_DEFAULT_MAX_TOKENS=4096
MUYE_LLM_TIMEOUT=30
MUYE_LLM_MAX_RETRIES=3

# LangSmith 为可选能力，启用时再填写密钥与 Endpoint。
# LangSmith is optional; provide its key and endpoint only when enabled.
MUYE_LLM_LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
MUYE_LLM_LANGSMITH_PROJECT=muye-llm
LANGSMITH_ENDPOINT=
